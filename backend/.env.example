# HTTP
PORT=3000

# Backend SQLite database
# Relative paths are resolved from backend/
DB_PATH=./data.sqlite

# JWT signing secret - generate a long random value for local development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# Deep-link scheme already used by the Expo app
RESET_APP_SCHEME=cmsc128lab1cruddeasis
